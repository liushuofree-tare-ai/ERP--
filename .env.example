# 汽配 ERP 服务器配置（复制为.env 后改值：cp.env.example.env）
# 端口（默认 3100）
PORT=3100

# 访问口令：不配 = 任何能访问到端口的人都能读写全部数据
ERP_ACCESS_PASSWORD=改成你们自己的口令
# 登录态签名密钥：不设则每次重启后都要重新输口令
# 生成方法：openssl rand -hex 24
ERP_AUTH_SECRET=改成一串随机字符

# 飞书群机器人 Webhook（可选：订单创建/收付款/发货播报到群）
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=
# 飞书自建应用（可选：免登 + 发文件）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
