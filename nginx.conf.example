# Nginx 反向代理模板（HTTPS 自行按已有证书体系接入，或用 certsbot 处理）。
# 用法：把文件里的 server.qipei.example.com 换成真实域名，放进
# /etc/nginx/conf.d/qipei-erp.conf 后 nginx -s reload。
server {
    listen 80;
    server_name qipei.example.com;

    # 大文件：多图客户单 .xlsx 回表上传 / 完整备份恢复 zip（服务端上限 60MB）
    client_max_body_size 60m;

    # gzip：API/静态资源
    gzip on;
    gzip_types text/html text/css application/javascript application/json;
    gzip_min_length 1024;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # 大文件恢复/备份导出可能慢几秒
        proxy_send_timeout 300s;
    }
}
